{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/map/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/map/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(map/brand|assets/brand|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/cloud",
      "destination": "/api/index"
    },
    {
      "source": "/api/cloud/",
      "destination": "/api/index"
    },
    {
      "source": "/api/cloud/rollup",
      "destination": "/api/index"
    },
    {
      "source": "/api/cloud/rollup/",
      "destination": "/api/index"
    }
  ]
}
