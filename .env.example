# The model that picks filters and writes reports. Set ONE key. With a Google key the gateway uses
# Gemini (Google's Gemini API); with only an Anthropic key it uses Claude; with neither, the tank's
# own rule decides and reports are written from the base station's checks.
# Gemini's free tier allows only about 20 requests a day per model, and one report takes a dozen
# or more, so turn on billing for the key.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=google          # or anthropic: which to use when both keys are set
# GEMINI_MODEL=gemini-3.5-flash

# Optional. Lets other devices on the network use the controls (tip the cup, reset a filter).
# Without it, only the machine running the gateway can. Pick any long random string.
CONTROL_TOKEN=

# Optional. Copies every reading to a cloud Postgres (Tiger Cloud / TimescaleDB on AWS). Paste the
# service's connection string here. The base station still stores everything itself, and catches the
# cloud up after an outage. Treat this like a password: it contains one.
TIGER_DATABASE_URL=
# Which base station this is, if there are several.
# STATION_ID=base-01
